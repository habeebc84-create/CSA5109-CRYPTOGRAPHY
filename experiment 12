key = [[9, 4],
       [5, 7]]

text = input("Enter plaintext: ").upper().replace(" ", "")

if len(text) % 2 != 0:
    text += "X"

result = ""

for i in range(0, len(text), 2):
    a = ord(text[i]) - 65
    b = ord(text[i + 1]) - 65

    c1 = (key[0][0] * a + key[0][1] * b) % 26
    c2 = (key[1][0] * a + key[1][1] * b) % 26

    result += chr(c1 + 65)
    result += chr(c2 + 65)

print("Encrypted Text:", result)
