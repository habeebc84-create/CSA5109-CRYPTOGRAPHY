# SHA-3 State Matrix (Simple Simulation)

state = [[0 for j in range(5)] for i in range(5)]

# Set first 3 rows (rate portion) to 1
for i in range(3):
    for j in range(5):
        state[i][j] = 1

print("SHA-3 State Matrix:")

for row in state:
    print(row)

print("\nAfter propagation, all lanes become nonzero.")
